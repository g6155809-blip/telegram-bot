# Required
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
ADMIN_TELEGRAM_ID=replace_with_owner_telegram_id

# Optional: set the username without @ if you prefer owner lookup by username too.
ADMIN_USERNAME=

# Replit AI Integration values are injected automatically after connecting OpenAI.
# For a normal server, set OPENAI_API_KEY instead.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional local data path.
DATA_FILE=./data/bot-state.json